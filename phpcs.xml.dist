<?xml version="1.0"?>
<ruleset name="EM Nuclear Reset">
    <description>WordPress coding standards for EM Nuclear Reset.</description>

    <file>em-nuclear-reset.php</file>
    <file>includes</file>
    <file>tests</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <config name="minimum_supported_wp_version" value="6.1"/>
    <config name="testVersion" value="7.4-"/>
</ruleset>